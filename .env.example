# Copy to .env (gitignored) and fill in for this computer. Never commit .env.

# LAN updates for debug builds. When set, every debug build gets a build-time version code, asks for network and
# APK-install permission, allows plain HTTP to this address only, and writes android/dist/dev-update/.
# scripts/serve-dev-update.sh then serves that folder, and the debug app on your phone updates from it.
# Leave unset (as in CI) for a debug build with no network access and no update check.
PASSVAULT_DEV_UPDATE_HOST=192.168.1.10
# Optional, defaults to 8766 (AquaRestore uses 8765, so both servers can run at once).
PASSVAULT_DEV_UPDATE_PORT=8766
