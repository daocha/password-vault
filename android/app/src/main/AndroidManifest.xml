<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Keeps the clipboard-clearing timer alive while the user pastes into another app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app hide other apps' overlays while it is visible (tapjacking protection). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Scanning authenticator QR codes. Asked for only when the user taps "Scan QR code". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Autofill reads these browsers' signing certificates to check that a browser asking for a site's login is the real one
         (AutofillBrowsers). Only browsers in the bundled privileged_browsers.json are listed; a unit test keeps the two in step. -->
    <queries>
        <package android:name="app.vanadium.browser" />
        <package android:name="com.android.chrome" />
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser_beta" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.canary" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="com.heytap.browser" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.browser.beta" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.sec.android.app.sbrowser.beta" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.yandex.browser" />
        <package android:name="org.chromium.chrome" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.klar" />
    </queries>
    <!-- Deliberately no INTERNET permission. Only the GitHub sideload build (src/release) and a debug build given a LAN
         update server (src/lanUpdate) add it, to update themselves. -->
    <application android:localeConfig="@xml/locales_config" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false"
        android:label="${appLabel}" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <!-- Autofill: the service only offers a locked suggestion; the vault is opened in AutofillActivity, and only until it fills or closes. -->
        <service android:name=".PassVaultAutofillService" android:exported="true" android:label="${appLabel}" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
        <activity android:name=".AutofillActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection" />
        <service android:name=".ClipboardClearService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Clears copied passwords from the clipboard after a user-chosen delay or when the app is closed." />
        </service>
    </application>
</manifest>
